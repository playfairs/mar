cabal-version:      3.0
name:               mar
version:            0.1.0.0
synopsis:           A fast local filesystem indexer and search CLI
description:        A persistent SQLite-backed filesystem index and search command-line tool.
license:            BSD-3-Clause
author:             mar contributors
category:           System
build-type:         Simple

executable mar
  main-is:          Main.hs
  hs-source-dirs:   app/mar
  build-depends:
      base >=4.17 && <5
    , aeson
    , bytestring
    , directory
    , filepath
    , sqlite-simple
    , text
    , time
    , mar
  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat -Widentities -Wincomplete-uni-patterns -Wincomplete-record-updates -Wmissing-export-lists -Wmissing-import-lists -threaded -O2

library
  hs-source-dirs:   src
  exposed-modules:
      Mar.CLI.Commands
    , Mar.CLI.Parser
    , Mar.Core.Path
    , Mar.Core.Types
    , Mar.Filesystem.Metadata
    , Mar.CLI.Output
    , Mar.Config.Paths
    , Mar.Config.Version
    , Mar.Index.Crawler
    , Mar.Index.Database
    , Mar.Index.Query
    , Mar.Index.Schema
    , Mar.Index.Updater
    , Mar.Search.Filters
  build-depends:
      base >=4.17 && <5
    , aeson
    , bytestring
    , directory
    , filepath
    , sqlite-simple
    , text
    , time
  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat -Widentities -Wincomplete-uni-patterns -Wincomplete-record-updates -Wmissing-export-lists -Wmissing-import-lists -Wredundant-constraints -O2

test-suite mar-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
      base >=4.17 && <5
    , directory
    , filepath
    , hspec
    , mar
    , text
    , time
  default-language: Haskell2010
  ghc-options:      -Wall