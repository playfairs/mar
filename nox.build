project "mar" {
  version = file("./VERSION")
  license = file("./UNLICENSE")

  executable.haskell "mar" {
    sources = [
      "app/mar/Main.hs",
      "src/Mar/CLI/Commands.hs",
      "src/Mar/CLI/Parser.hs",
      "src/Mar/Core/Path.hs",
      "src/Mar/Core/Types.hs",
      "src/Mar/Filesystem/Metadata.hs",
      "src/Mar/CLI/Output.hs",
      "src/Mar/Config/Paths.hs",
      "src/Mar/Config/Version.hs",
      "src/Mar/Index/Crawler.hs",
      "src/Mar/Index/Database.hs",
      "src/Mar/Index/Query.hs",
      "src/Mar/Index/Schema.hs",
      "src/Mar/Index/Updater.hs",
      "src/Mar/Search/Filters.hs",
    ]
    install = true
  }
}