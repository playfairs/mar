project "mar" {
  version = "0.1.0.0"

  executable "mar" {
    sources = [
      "app/mar/Main.hs",
      "src/Mar/CLI/Commands.hs",
      "src/Mar/CLI/Parser.hs",
      "src/Mar/Core/Entry.hs",
      "src/Mar/Core/Error.hs",
      "src/Mar/Core/Path.hs",
      "src/Mar/Core/Types.hs",
      "src/Mar/Filesystem/Metadata.hs",
      "src/Mar/Filesystem/Operations.hs",
      "src/Mar/Navigation/State.hs",
      "src/Mar/Preview/Preview.hs",
      "src/Mar/TUI/Application.hs"
    ]
    flags = ["-threaded"]
    install = true
  }
}